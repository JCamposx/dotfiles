#!/bin/bash
set -euo pipefail

# Styles
RESET="\033[0m"
BOLD="\033[1m"
ITALIC="\033[3m"

# Colors
GREEN="\033[32m"
BLUE="\033[34m"
YELLOW="\033[33m"
RED="\033[31m"

# Print failed command on error
trap 'echo -e "${BOLD}${RED}Failed at:${RESET} $BASH_COMMAND" >&2' ERR

# Print and execute a command
run() {
    echo -e "${BOLD}${BLUE}Running${RESET} ${ITALIC}${BOLD}${YELLOW}$*${RESET}"
    "$@"
}

# Update, upgrade, and clean up Homebrew
run brew update
run brew upgrade --greedy
run brew autoremove
run brew cleanup --prune all

# Print styled summary
echo -e "${BOLD}${GREEN}Homebrew successfully updated${RESET}"
