#!/bin/bash
set -euo pipefail

# Styles
RESET="\033[0m"
BOLD="\033[1m"
GREEN="\033[32m"
YELLOW="\033[33m"

# Target directory (defaults to current)
TARGET_PATH="${1:-.}"

if [ ! -d "$TARGET_PATH" ]; then
  echo "Error: '$TARGET_PATH' is not a valid directory." >&2
  exit 1
fi

# Temp file for counting without interfering with stdout
countfile=$(mktemp)
trap 'rm -f "$countfile"' EXIT

# Find and delete .DS_Store files
find -P "$TARGET_PATH" -name ".DS_Store" -type f \
  -print -delete \
  -exec sh -c 'printf x >> "$1"' _ "$countfile" \;

# Count deleted files
if [ -s "$countfile" ]; then
  count=$(wc -c < "$countfile" | tr -d ' ')
else
  count=0
fi

# Print styled summary
if [ "$count" -eq 0 ]; then
  echo -e "${BOLD}${YELLOW}No .DS_Store files found${RESET}"
elif [ "$count" -eq 1 ]; then
  echo -e "${BOLD}${GREEN}Deleted 1 .DS_Store file${RESET}"
else
  echo -e "${BOLD}${GREEN}Deleted ${count} .DS_Store files${RESET}"
fi
